{
  "name": "absensi",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "wrangler dev .output/server/index.mjs --assets .output/public",
    "postinstall": "nuxt prepare",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:server": "vitest --project server",
    "test:api": "vitest run --project server",
    "test:db": "vitest run --project server test/nuxt/db.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:remote": "node scripts/seed.mjs --remote",
    "db:studio": "drizzle-kit studio",
    "deploy:config": "node scripts/deploy-config.mjs",
    "deploy": "pnpm db:migrate:remote --config wrangler.deploy.jsonc && wrangler deploy .output/server/index.mjs --assets .output/public --config wrangler.deploy.jsonc"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.100",
    "@nuxt/test-utils": "4.3.4",
    "@nuxt/ui": "^4.12.0",
    "@vueuse/nuxt": "15.0.0",
    "argon2-wasm-edge": "^1.0.23",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "nuxt": "^4.6.3",
    "nuxt-auth-utils": "0.6.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "wrangler": "^4.157.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "happy-dom": "^21.0.4",
    "jsonc-parser": "^3.3.1",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unwasm": "^0.6.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@12.15.0"
}
